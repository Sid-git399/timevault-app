generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("USER")
  favorites    Favorite[]
  inquiries    Inquiry[]
  createdAt    DateTime   @default(now())
}

model Watch {
  id                String     @id @default(cuid())
  slug              String     @unique
  brand             String
  model             String
  referenceNumber   String
  movement          String
  caseMaterial      String
  caseDiameterMm    Int
  waterResistanceM  Int
  yearProduced      Int
  condition         String
  boxAndPapers      Boolean    @default(false)
  priceCents        Int
  description       String
  imageSeed         String
  available         Boolean    @default(true)
  createdAt         DateTime   @default(now())
  favorites         Favorite[]
  inquiries         Inquiry[]

  @@index([brand])
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  watch     Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  watchId   String
  createdAt DateTime @default(now())

  @@unique([userId, watchId])
  @@index([userId])
}

model Inquiry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  watch     Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  watchId   String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([watchId])
}